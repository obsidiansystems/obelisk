#!/usr/bin/env bash
# ob-run: Development server with in-process backend reloading and in-place
# frontend rebuilds.
#
# The backend runs inside a ghcid session: saving a backend/common/frontend
# module recompiles it to bytecode and reruns the server in-process: no
# native linking, no process restart. A separate watcher cross-compiles the
# frontend (WASM by default) and assembles the served assets in place under
# the running server; refresh the browser to pick them up.
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "Usage: ob-run [--js] [-- BACKEND_ARGS...]"
  echo ""
  echo "  Runs the backend under ghcid: backend/common/frontend modules reload"
  echo "  in-process on save (no relink, no restart) and the server reruns."
  echo "  A separate watcher cross-compiles the frontend (WASM by default) and"
  echo "  swaps the served assets in place; refresh the browser to see them."
  echo "  Editing a .cabal file or cabal.project restarts the ghcid session."
  echo ""
  echo "  --js            build the GHCJS frontend (frontend-js) instead of WASM"
  echo "  BACKEND_ARGS    after --, passed to the backend (Snap options,"
  echo "                  e.g. 'ob-run -- --port=8017')"
  exit 0
fi

# Parse arguments: optional --js, then -- followed by backend (Snap) args.
FRONTEND_PKG=frontend-wasm
BACKEND_ARGS=()
SEEN_DASHDASH=false
for arg in "$@"; do
  if [[ "$arg" == "--" ]]; then
    SEEN_DASHDASH=true
  elif $SEEN_DASHDASH; then
    BACKEND_ARGS+=("$arg")
  elif [[ "$arg" == "--js" ]]; then
    FRONTEND_PKG=frontend-js
  else
    echo "ob-run: unknown argument '$arg'; see 'ob-run --help'." >&2
    exit 1
  fi
done

DEV_GHC_OPTIONS=(
  --ghc-options=-O0
  --ghc-options=-fno-specialise
  --ghc-options=-fno-expose-all-unfoldings
  --ghc-options=-fno-specialise-aggressively
  --ghc-options=-fno-late-specialise
  --ghc-options=-fno-cross-module-specialise
)

export OBELISK_CROSS_CABAL_ARGS="-O0 ${DEV_GHC_OPTIONS[*]}"

# Resolve the backend's Cabal data dir deterministically in the repl session
# (Paths_backend honors this standard override).
backend_datadir="$PWD/backend/data"
export backend_datadir

# Ensure the data symlinks the backend serves from exist (normally created by
# the Setup.hs hooks during `cabal build backend`).
mkdir -p backend/data frontend/data
ln -sfn "$PWD/frontend/data/frontend.jsexe" backend/data/frontend.jsexe
ln -sfn "$PWD/frontend/data/static" backend/data/static

GHCID_PID=""
WATCH_PID=""
cleanup() {
  if [[ -n "$WATCH_PID" ]]; then kill "$WATCH_PID" 2>/dev/null || true; fi
  if [[ -n "$GHCID_PID" ]]; then kill "$GHCID_PID" 2>/dev/null || true; fi
}
trap cleanup EXIT

# Frontend asset watcher: rebuild the cross-compiled frontend whenever
# frontend/common/static sources change. The wrapper package's Setup.hs does
# the cross-build (incremental, persistent dist-wasm) and assembles the jsexe
# into frontend/data/, which the running server serves through symlinks.
# A separate --builddir keeps this cabal invocation from contending with
# ghcid's live repl session over dist-newstyle.
(
  while true; do
    cabal build "$FRONTEND_PKG" -O0 "${DEV_GHC_OPTIONS[@]}" --builddir=dist-devfrontend \
      || echo "[ob-run] frontend build failed; fix the error and save to retry" >&2
    inotifywait -r -e modify,create,delete,move \
      --include '\.(hs|cabal)$' \
      frontend common static 2>/dev/null || sleep 2
  done
) &
WATCH_PID=$!

# Backend under ghcid: in-process bytecode reload + rerun of the server on
# save. Runs Backend.run, the entry point the backend library exports (the
# backend executable's Main is a thin wrapper around it). -f -cross drops
# the dependency on the frontend wrapper so the repl never cross-compiles.
#
# The frontend code is used twice, on purpose. lib:frontend here is the copy
# the backend calls for server-side rendering; loading it in the repl means
# frontend edits update the served HTML in about a second. The browser never
# runs this copy (this is not jsaddle-warp): what the browser executes is the
# cross-compiled output the watcher above rebuilds, which is slower but is
# the real artifact.
ghcid \
  -c "cabal repl lib:backend lib:common lib:frontend -O0 -f -cross ${DEV_GHC_OPTIONS[*]}" \
  --test Backend.run \
  --setup ":set args ${BACKEND_ARGS[*]}" \
  --restart=cabal.project \
  --restart=backend/backend.cabal \
  --restart=common/common.cabal \
  --restart=frontend/frontend.cabal &
GHCID_PID=$!

wait "$GHCID_PID"
