#!/usr/bin/env bash
# ob-run: Development server that rebuilds and restarts the backend on source changes.
# Disables optimizations (-O0 and -fno-* flags) for faster rebuilds.
# Triggers on .hs, .cabal, .project file changes or when the user presses Enter.
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "Usage: ob-run [-- CABAL_ARGS...]"
  echo ""
  echo "  Runs 'cabal run backend' with optimizations disabled and restarts it"
  echo "  whenever .hs, .cabal, or .project files change in backend/, common/,"
  echo "  or frontend/. Disables -O2, -fspecialise, -fexpose-all-unfoldings,"
  echo "  -fspecialise-aggressively, -flate-specialise, and -fcross-module-specialise"
  echo "  for faster rebuilds."
  echo "  Extra arguments after -- are passed through to cabal run."
  echo "  Press Enter to force a restart."
  exit 0
fi

# Kill the backend process on exit.
trap 'kill "$PID" 2>/dev/null' EXIT

restart() {
  kill "$PID" 2>/dev/null || true
  wait "$PID" 2>/dev/null || true
  echo "Restarting..."
}

while true; do
  # Run the backend in the background with optimizations disabled.
  DEV_GHC_OPTIONS=(
    --ghc-options=-O0
    --ghc-options=-fno-specialise
    --ghc-options=-fno-expose-all-unfoldings
    --ghc-options=-fno-specialise-aggressively
    --ghc-options=-fno-late-specialise
    --ghc-options=-fno-cross-module-specialise
  )
  OBELISK_CROSS_CABAL_ARGS="-O0 ${DEV_GHC_OPTIONS[*]}" \
    cabal run backend -O0 "${DEV_GHC_OPTIONS[@]}" "$@" &
  PID=$!

  # Watch for source file changes.
  inotifywait -r -e modify,create,delete \
    --include '\.(hs|cabal|project)$' \
    backend common frontend 2>/dev/null &
  INOTIFY_PID=$!

  # Also allow manual restart by pressing Enter.
  read -r < /dev/tty 2>/dev/null &
  READ_PID=$!

  # Restart on whichever triggers first.
  wait -n "$INOTIFY_PID" "$READ_PID" 2>/dev/null || true
  kill "$INOTIFY_PID" 2>/dev/null || true
  kill "$READ_PID" 2>/dev/null || true

  restart
done
