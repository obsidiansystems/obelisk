cabal-version: 2.2
name: obelisk-route
version: 0.2
build-type: Simple

common common
  default-language: Haskell2010

  default-extensions:
      ApplicativeDo
    , BangPatterns
    , CPP
    , ConstraintKinds
    , DataKinds
    , DefaultSignatures
    , DeriveFunctor
    , DeriveGeneric
    , EmptyCase
    , EmptyDataDecls
    , FlexibleContexts
    , FlexibleInstances
    , FunctionalDependencies
    , GADTs
    , GeneralizedNewtypeDeriving
    , ImportQualifiedPost
    , KindSignatures
    , LambdaCase
    , LiberalTypeSynonyms
    , MultiParamTypeClasses
    , NumDecimals
    , OverloadedStrings
    , PackageImports
    , PatternSynonyms
    , QuantifiedConstraints
    , RankNTypes
    , RecursiveDo
    , ScopedTypeVariables
    , StandaloneDeriving
    , TemplateHaskell
    , TemplateHaskellQuotes
    , TupleSections
    , TypeApplications
    , TypeFamilies
    , TypeOperators
    , UndecidableInstances
    , ViewPatterns

common warnings
  ghc-options: -Wall -Werror -fprint-potential-instances -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates

library
  import: common, warnings
  hs-source-dirs: src
  build-depends: base,
                 aeson,
                 bytestring,
                 categories,
                 constraints,
                 constraints-extras,
                 containers,
                 dependent-map,
                 dependent-sum,
                 dependent-sum-template,
                 either,
                 ghcjs-dom,
                 http-types,
                 jsaddle,
                 lens,
                 mmorph,
                 monad-control,
                 mtl,
                 network-uri,
                 obelisk-executable-config-lookup,
                 primitive,
                 ref-tf,
                 reflex,
                 reflex-dom-core,
                 semigroupoids,
                 template-haskell,
                 tabulation,
                 text,
                 transformers,
                 universe,
                 universe-some

  exposed-modules: Obelisk.Route
                   Obelisk.Route.TH
                   Obelisk.Route.Frontend

  ghc-options: -O

test-suite roundtrips
  import: common, warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options: -O

  -- QuickCheck 2.18 deprecates withMaxSuccess, and older versions lack withNumTests.
  ghc-options: -Wno-deprecations

  -- https://gitlab.haskell.org/ghc/ghc/-/issues/25442
  if !os(wasi)
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N"

  -- https://gitlab.haskell.org/ghc/ghc/-/merge_requests/14362
  if arch(javascript)
    ld-options: -sEXPORTED_RUNTIME_METHODS=HEAP8

  build-depends:
    QuickCheck,
    aeson,
    base,
    categories,
    containers,
    dependent-map,
    dependent-sum,
    dependent-sum-template,
    lens,
    some,
    obelisk-route,
    quickcheck-instances,
    tabulation,
    tasty,
    tasty-quickcheck,
    text,
    transformers,
    universe,
    universe-some
