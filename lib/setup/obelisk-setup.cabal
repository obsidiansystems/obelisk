cabal-version: 3.4
name:          obelisk-setup
version:       0.1
license:       BSD-3-Clause
data-dir:      data
data-files:    shim.js

common common
  default-language: Haskell2010

  default-extensions:
      ApplicativeDo
    , BangPatterns
    , CPP
    , ConstraintKinds
    , DataKinds
    , DefaultSignatures
    , DeriveFunctor
    , DeriveGeneric
    , EmptyCase
    , EmptyDataDecls
    , FlexibleContexts
    , FlexibleInstances
    , FunctionalDependencies
    , GADTs
    , GeneralizedNewtypeDeriving
    , ImportQualifiedPost
    , KindSignatures
    , LambdaCase
    , LiberalTypeSynonyms
    , MultiParamTypeClasses
    , NumDecimals
    , OverloadedStrings
    , PackageImports
    , PatternSynonyms
    , QuantifiedConstraints
    , RankNTypes
    , RecursiveDo
    , ScopedTypeVariables
    , StandaloneDeriving
    , TemplateHaskell
    , TemplateHaskellQuotes
    , TupleSections
    , TypeApplications
    , TypeFamilies
    , TypeOperators
    , UndecidableInstances
    , ViewPatterns

library
  import:           common
  hs-source-dirs:   src
  exposed-modules:
    Obelisk.Setup.Utils
  ghc-options: -Wall
  build-depends:
    base >= 4.7 && < 5,
    Cabal >= 3.0 && < 4,
    directory >= 1.3.6 && < 2,
    filepath >= 1.4 && < 2

  if !(arch(javascript) || arch(wasm32))
    exposed-modules:
      Obelisk.Setup.Backend
      Obelisk.Setup.Frontend.Js
      Obelisk.Setup.Frontend.Wasm
      Obelisk.Setup.Static
    other-modules:
      Paths_obelisk_setup
    autogen-modules:
      Paths_obelisk_setup
    build-depends:
      containers,
      obelisk-asset-manifest,
      process >= 1.6 && < 2,
      text
