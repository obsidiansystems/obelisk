cabal-version:       2.2
-- Initial package description 'tabulation.cabal' generated by 'cabal
-- init'.  For further documentation, see
-- http://haskell.org/cabal/users-guide/

name:                tabulation
version:             0.1.0.0
synopsis:            A library for types that can be completely reconstructed by fields as specified by a GADT.
-- description:
-- bug-reports:
license:             BSD-3-Clause
license-file:        LICENSE
author:              Cale Gibbard
maintainer:          cale.gibbard@obsidian.systems
-- copyright:
category:            Data
build-type:          Simple
extra-source-files:  CHANGELOG.md

common common
  default-language: Haskell2010

  default-extensions:
      ApplicativeDo
    , BangPatterns
    , CPP
    , ConstraintKinds
    , DataKinds
    , DefaultSignatures
    , DeriveFunctor
    , DeriveGeneric
    , EmptyCase
    , EmptyDataDecls
    , FlexibleContexts
    , FlexibleInstances
    , FunctionalDependencies
    , GADTs
    , GeneralizedNewtypeDeriving
    , ImportQualifiedPost
    , KindSignatures
    , LambdaCase
    , LiberalTypeSynonyms
    , MultiParamTypeClasses
    , NumDecimals
    , OverloadedStrings
    , PackageImports
    , PatternSynonyms
    , QuantifiedConstraints
    , RankNTypes
    , RecursiveDo
    , ScopedTypeVariables
    , StandaloneDeriving
    , TemplateHaskell
    , TemplateHaskellQuotes
    , TupleSections
    , TypeApplications
    , TypeFamilies
    , TypeOperators
    , UndecidableInstances
    , ViewPatterns

library
  import:              common
  exposed-modules: Data.Tabulation
  build-depends:       base, lens
  hs-source-dirs:      src
