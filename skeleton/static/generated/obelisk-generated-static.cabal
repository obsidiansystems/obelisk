cabal-version:      3.4
name:               obelisk-generated-static
version:            0.1.0.0
license:            NONE
build-type:         Simple
data-dir:           data
data-files:         .keep

library
    default-language:   Haskell2010
    hs-source-dirs:     src
    exposed-modules:    Obelisk.Generated.Static
    build-depends:      base
                      , ghc-prim
                      , text

    if !(arch(javascript) || arch(wasm32))
      build-depends: obelisk-generated-static-custom
